rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// Reelst Firestore security rules
//
// Public-by-default for read (agent profiles, pins, sitemap)
// Strict ownership for writes — users can only mutate their own data
// Showing requests are write-anywhere (lead capture) but read-protected
// ─────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── USERS ──
    // Public read (agent profiles are discoverable)
    // Users can create their own doc on signup
    // Only the user can update their doc
    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false; // soft-delete via account deactivation only
    }

    // ── USERNAMES (username → uid lookup table) ──
    // Public read so login/profile lookups work
    // Only the claiming user can create their own entry
    // Username must be 3-24 lowercase letters, and not collide with
    // any reserved route, brand identity, or system-y name.
    // KEEP RESERVED LIST IN SYNC WITH src/lib/reservedUsernames.ts
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z]{3,24}$')
        && !(username in [
          'about', 'pricing', 'blog', 'glossary', 'terms', 'privacy',
          'signup', 'signin', 'welcome', 'verify', 'dashboard',
          'saved', 'auth', 'dev', 'email', 'marketing', 'index',
          'u', 'sitemap', 'robots', 'favicon', 'icons',
          'register', 'community', 'connect', 'termsofuse', 'privacypolicy',
          'explore', 'features', 'faq', 'faqs', 'contact', 'careers', 'jobs',
          'press', 'news', 'team', 'company', 'mission', 'story', 'brand',
          'partners', 'investors', 'media', 'plans',
          'download', 'app', 'mobile', 'ios', 'android', 'demo', 'trial',
          'pro', 'premium', 'enterprise', 'free',
          'agents', 'agent', 'broker', 'brokers', 'brokerage',
          'listings', 'listing', 'properties', 'property', 'homes', 'home',
          'neighborhoods', 'markets', 'reviews',
          'search', 'discover', 'browse', 'feed', 'nearby',
          'settings', 'account', 'accounts', 'profile', 'profiles',
          'billing', 'subscription', 'subscriptions', 'invoices',
          'payment', 'payments', 'notifications', 'inbox', 'messages', 'chat',
          'admin', 'administrator', 'root', 'owner', 'staff', 'moderator',
          'mod', 'support', 'help', 'helpdesk', 'security', 'legal',
          'compliance', 'abuse',
          'api', 'www', 'mail', 'smtp', 'ftp', 'cdn', 'static', 'assets',
          'public', 'private',
          'login', 'logout', 'signout', 'me', 'you', 'myself', 'user', 'users',
          'noreply', 'nobody', 'null', 'undefined', 'anonymous', 'system',
          'bot', 'official',
          'reelstofficial', 'realestate', 'realtor', 'mls', 'zillow', 'redfin', 'compass',
          'info', 'hello', 'contact', 'customerservice', 'customer',
          'inquiry', 'inquiries', 'feedback'
        ]);
      allow update, delete: if false;
    }

    // ── LICENSES ({state}_{number} → uid lookup table) ──
    // Read is open so the onboarding "is this license taken?" check
    // can run pre-signup. Create is the atomic enforcement: Firestore
    // rejects create on an existing doc id, so two agents can't both
    // claim the same state-license-number combo.
    match /licenses/{licenseId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── PINS (listings + neighborhoods) ──
    // Public read — anyone can see active listings
    // Only the owning agent can write
    match /pins/{pinId} {
      allow read: if true;
      // New pins must default to enabled=false. Activation goes through
      // the setPinEnabled callable so the per-tier active-pin cap is
      // enforced server-side.
      allow create: if isSignedIn()
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.enabled == false;
      // Owners may freely update most fields and may DISABLE a pin
      // (enabled: false), but flipping enabled to true must go through
      // the setPinEnabled callable. archivePin sets enabled=false so it
      // continues to work.
      allow update: if isSignedIn()
        && resource.data.agentId == request.auth.uid
        && (
          request.resource.data.enabled == resource.data.enabled
          || request.resource.data.enabled == false
        );
      allow delete: if isSignedIn() && resource.data.agentId == request.auth.uid;
    }

    // ── SAVES (bookmarks) ──
    // The saver can read/write their own saves. The agent who owns
    // the saved pin can also read (powers the Audience Crossover
    // insight, which needs to see overlap between savers across the
    // agent's listings).
    match /saves/{saveId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/pins/$(resource.data.pinId)).data.agentId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── SHOWING REQUESTS ──
    // Anonymous buyer creates go through the submitShowingRequest
    // callable (admin SDK, rate-limited, server-validated) — direct
    // client writes are blocked. Only the receiving agent can read /
    // update / delete their own requests.
    match /showing_requests/{reqId} {
      allow create: if false; // Cloud Function only
      allow read: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.agentId == request.auth.uid;
    }

    // ── SHARED MAPS (publicly shareable saved-pin collections) ──
    // Public read (that's the whole point — links are shareable)
    // Only the owner can create/update their share
    match /shared_maps/{shareId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── REPORTS (content moderation) ──
    // Any signed-in user can create a report
    // Only the reporter can read their own reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false; // admin-only via Cloud Functions
    }

    // ── CONTENT LIBRARY (standalone media items) ──
    // Only the owning agent can CRUD their own content
    match /content/{contentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.agentId == request.auth.uid;
    }

    // ── DMCA TAKEDOWN REQUESTS ──
    // Anyone can submit a DMCA request (copyright holders may not have accounts)
    match /dmca_requests/{reqId} {
      allow create: if true;
      allow read, update, delete: if false; // admin-only
    }

    // ── NOTIFICATIONS ──
    // Agents can read their own notifications and mark as read
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow create, delete: if false; // Cloud Functions only
    }

    // ── ANALYTICS EVENTS ──
    // Read by the agent for their own insights
    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // ── SUBSCRIBER SNAPSHOTS ──
    // Daily counts written by dailySubscriberSnapshot Cloud Function.
    // Powers the dashboard "Saves over time" line chart.
    match /subscriber_snapshots/{snapId} {
      allow read: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // ── MUX ASSETS ──
    match /muxAssets/{assetId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // ── RATE LIMITS ──
    // Server-only — only Cloud Functions (admin SDK) write/read these.
    // Backs per-user / per-IP rate limits on Mux uploads, wave/showing
    // submissions, digest signups, auth emails, feedback, etc.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ── DIGEST SUBSCRIPTIONS (Save Maya — email-only) ──
    // Anonymous buyer creates go through the submitDigestSubscription
    // callable (admin SDK) — direct client writes are blocked so we
    // don't have to expose read/update on subscription docs. Owning
    // agent can read their own subscriber list + delete entries.
    match /digestSubscriptions/{subId} {
      allow read: if isSignedIn()
        && resource.data.agentId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.agentId == request.auth.uid;
      allow create, update: if false; // Cloud Function only
    }

    // ── WAVES (buyer questions on listings) ──
    // Subcollection of pins. Buyer creates go through the submitWave
    // callable Cloud Function (rate-limited, validated, admin-SDK
    // write) — direct client creates are denied. Owning agent can
    // read + update (mark read / change status).
    //
    // Rule reads `agentId` straight off the wave doc — submitWave
    // denormalizes it at write time, so no parent get() needed.
    //
    // The recursive `{path=**}` wildcard is REQUIRED for the rule to
    // apply to collectionGroup queries (the dashboard's "Waves" stat
    // card runs `collectionGroup('waves')`). Without it, Firestore
    // silently denies the collectionGroup read even though the
    // matched-path rule looks correct.
    match /{path=**}/waves/{waveId} {
      allow read: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.agentId == request.auth.uid;
      allow create, delete: if false;
    }

    // ── PIN PENDING CHANGES (subcollection of pins) ──
    // Written by the syncPropertyData scheduled function. The pin's
    // owning agent can read + delete (delete = approve/reject). No
    // direct client writes — the Cloud Function is the only producer.
    match /pins/{pinId}/pendingChanges/{changeId} {
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/pins/$(pinId)).data.agentId == request.auth.uid;
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/pins/$(pinId)).data.agentId == request.auth.uid;
      allow create, update: if false;
    }

    // ── BLOG POSTS (FireCMS-managed) ──
    // Public reads only for posts whose status is "published" — drafts +
    // scheduled posts stay invisible to anonymous /blog visitors.
    // Writes gated by the `admin: true` custom claim, set via
    // functions/grant-admin.mjs. Add more admins by running the script
    // for additional UIDs — no rules change needed.
    match /posts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // ── BLOG AUTHORS (FireCMS-managed) ──
    // Public reads (author bio renders on the post page).
    // Writes restricted to the same admin-claim allowlist as posts.
    match /authors/{authorId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // ── DEFAULT DENY ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
